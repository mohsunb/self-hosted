push.mohsun.az, http://push.mohsun.az {
        reverse_proxy ntfy:80

        @httpget {
                protocol http
                method GET
                path_regexp ^/([-_a-z0-9]{0,64}$|docs/|static/)
        }
        redir @httpget https://{host}{uri}

        # log {
        #         output file /var/log/caddy/ntfy/access.log
        # }
}
