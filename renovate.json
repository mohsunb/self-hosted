{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/argocd/.+/app\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/argocd/.+/deployment\\.yaml$/",
      "/argocd/apps/renovate/cronjob\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "CloudNativePG",
      "managerFilePatterns": [
        "/argocd/cnpg/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>cloudnative-pg/cloudnative-pg)/releases/download/v(?<currentValue>[\\d.]+)/cnpg-[\\d.]+\\.ya?ml"
      ],
      "autoReplaceStringTemplate": "https://github.com/{{depName}}/releases/download/v{{newValue}}/cnpg-{{newValue}}.yaml",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Immich",
      "managerFilePatterns": [
        "/argocd/apps/immich/app\\.yaml$/"
      ],
      "matchStrings": [
        "tag:\\s*(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/immich-app/immich-server"
    },
    {
      "customType": "regex",
      "description": "GitHub releases used in Kustomize",
      "managerFilePatterns": [
        "/argocd/.+/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v?[\\d.]+)/[a-zA-Z][a-zA-Z-]*\\.ya?ml"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/argocd/apps/immich/database\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>ghcr\\.io/tensorchord/cloudnative-vectorchord):(?<currentValue>[0-9.-]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<compatibility>\\d+)\\.(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    }
  ]
}
