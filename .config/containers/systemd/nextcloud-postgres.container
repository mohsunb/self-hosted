[Unit]
Description=Nextcloud PostgreSQL container

[Container]
Image=docker.io/postgres:17.5
ContainerName=nextcloud-postgres
Network=nextcloud.network
NetworkAlias=postgresql
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/nextcloud-postgres-password
Secret=nextcloud-postgres-password
Volume=/home/mohsun/Data/Nextcloud/postgresql:/var/lib/postgresql/data:Z

[Install]
WantedBy=default.target
